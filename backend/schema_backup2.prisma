generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccountingPeriod {
  id                                    Int           @id @default(autoincrement())
  userId                                Int           @map("user_id")
  financialYearId                       Int           @map("financial_year_id")
  periodNumber                          Int           @map("period_number")
  name                                  String        @db.VarChar(50)
  startDate                             DateTime      @map("start_date") @db.Date
  endDate                               DateTime      @map("end_date") @db.Date
  status                                PeriodStatus  @default(OPEN)
  closedAt                              DateTime?     @map("closed_at")
  closedBy                              Int?          @map("closed_by")
  createdAt                             DateTime      @default(now()) @map("created_at")
  updatedAt                             DateTime      @updatedAt @map("updated_at")
  usersAccountingPeriodsClosedByTousers User?         @relation("accounting_periods_closed_byTousers", fields: [closedBy], references: [id])
  financialYears                        FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  usersAccountingPeriodsUserIdTouser    User          @relation("accounting_periods_user_idTousers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, financialYearId, periodNumber])
  @@map("accounting_periods")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @default(0) @map("user_id")
  action     String   @db.VarChar(100)
  details    String?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  entityId   Int?     @map("entity_id")
  entityType String?  @map("entity_type") @db.VarChar(100)
  status     String?  @db.VarChar(50)
  user       User     @relation(fields: [userId], references: [id], onDelete: SetDefault)

  @@index([action])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model BankAccount {
  id             Int             @id @default(autoincrement())
  userId         Int             @map("user_id")
  accountName    String          @map("account_name") @db.VarChar(200)
  bankName       String?         @map("bank_name") @db.VarChar(200)
  accountNumber  String?         @map("account_number")
  ifscCode       String?         @map("ifsc_code") @db.VarChar(20)
  branchName     String?         @map("branch_name")
  openingBalance Decimal         @default(0) @map("opening_balance") @db.Decimal(15, 2)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankStatements BankStatement[]

  @@index([userId])
  @@map("bank_accounts")
}

model BankStatement {
  id          Int          @id @default(autoincrement())
  userId      Int          @map("user_id")
  accountId   Int?         @map("account_id")
  txnDate     DateTime     @map("txn_date") @db.Date
  txnType     BankTxnType  @map("txn_type")
  description String?
  amount      Decimal      @db.Decimal(15, 2)
  balance     Decimal?     @db.Decimal(15, 2)
  category    String?      @db.VarChar(100)
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  account     BankAccount? @relation(fields: [accountId], references: [id])
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([txnDate])
  @@index([userId])
  @@map("bank_statements")
}

model ChartOfAccount {
  id                   Int              @id @default(autoincrement())
  userId               Int              @map("user_id")
  code                 String           @db.VarChar(50)
  name                 String           @db.VarChar(200)
  accountType          String           @db.VarChar(50)
  accountSubType       String?          @db.VarChar(100)
  parentId             Int?             @map("parent_id")
  isSystemAccount      Boolean          @default(false) @map("is_system_account")
  isActive             Boolean          @default(true) @map("is_active")
  description          String?
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  account              ChartOfAccount?  @relation("chart_of_accountsTochart_of_accounts", fields: [parentId], references: [id], onDelete: Restrict)
  otherChartOfAccounts ChartOfAccount[] @relation("chart_of_accountsTochart_of_accounts")
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines                JournalLine[]

  @@unique([userId, code])
  @@index([accountType])
  @@index([isActive])
  @@index([parentId])
  @@index([userId])
  @@map("chart_of_accounts")
}

model CustomerPaymentAllocation {
  id              Int             @id @default(autoincrement())
  userId          Int             @map("user_id")
  paymentId       Int             @map("payment_id")
  saleId          Int             @map("sale_id")
  amountAllocated Decimal         @map("amount_allocated") @db.Decimal(15, 2)
  createdAt       DateTime        @default(now()) @map("created_at")
  customerPayment CustomerPayment @relation(fields: [paymentId], references: [id])
  sale            Sale            @relation(fields: [saleId], references: [id])
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([saleId])
  @@index([userId])
  @@map("customer_payment_allocations")
}

model CustomerPayment {
  id          Int                         @id @default(autoincrement())
  userId      Int                         @map("user_id")
  customerId  Int                         @map("customer_id")
  amount      Decimal                     @db.Decimal(15, 2)
  unallocated Decimal                     @db.Decimal(15, 2)
  paymentDate DateTime                    @map("payment_date") @db.Date
  mode        String                      @default("Cash") @db.VarChar(50)
  reference   String?                     @db.VarChar(100)
  notes       String?
  status      String                      @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")
  allocations CustomerPaymentAllocation[]
  customer    Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([userId])
  @@map("customer_payments")
}

model Customer {
  id                 Int               @id @default(autoincrement())
  userId             Int               @map("user_id")
  companyName        String            @map("company_name") @db.VarChar(200)
  gstin              String?
  contact            String?
  phone              String?
  email              String?
  address            String?
  deliveryAddress    String?           @map("delivery_address")
  paymentTerms       Int               @default(30) @map("payment_terms")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  openingBalance     Decimal           @default(0) @map("opening_balance") @db.Decimal(15, 2)
  openingBalanceDate DateTime?         @map("opening_balance_date") @db.Date
  customerPayments   CustomerPayment[]
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryChallans   DeliveryChallan[]
  quotations         Quotation[]
  sales              Sale[]
  returns            SalesReturn[]

  @@index([userId])
  @@map("customers")
}

model DcInvoiceItem {
  id                    Int                 @id @default(autoincrement())
  deliveryChallanItemId Int                 @map("delivery_challan_item_id")
  saleItemId            Int                 @map("sale_item_id")
  saleId                Int                 @map("sale_id")
  quantity              Decimal             @db.Decimal(15, 3)
  createdAt             DateTime            @default(now()) @map("created_at")
  deliveryChallanItems  DeliveryChallanItem @relation(fields: [deliveryChallanItemId], references: [id], onDelete: Cascade)
  sale                  Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleItem              SaleItem            @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  @@index([deliveryChallanItemId])
  @@index([saleId])
  @@index([saleItemId])
  @@map("dc_invoice_items")
}

model DeliveryChallanItem {
  id                Int             @id @default(autoincrement())
  deliveryChallanId Int             @map("delivery_challan_id")
  materialId        Int?            @map("material_id")
  quotationItemId   Int?            @map("quotation_item_id")
  materialName      String          @map("material_name") @db.VarChar(200)
  quantity          Decimal         @db.Decimal(15, 3)
  unit              String          @default("Nos") @db.VarChar(50)
  notes             String?
  dcInvoiceItems    DcInvoiceItem[]
  deliveryChallan   DeliveryChallan @relation(fields: [deliveryChallanId], references: [id], onDelete: Cascade)
  material          Material?       @relation(fields: [materialId], references: [id])
  quotationItem     QuotationItem?  @relation(fields: [quotationItemId], references: [id])

  @@index([deliveryChallanId])
  @@index([materialId])
  @@map("delivery_challan_items")
}

model DeliveryChallan {
  id              Int                   @id @default(autoincrement())
  userId          Int                   @map("user_id")
  customerId      Int?                  @map("customer_id")
  quotationId     Int?                  @map("quotation_id")
  dcNo            String?               @map("dc_no") @db.VarChar(100)
  dcDate          DateTime              @map("dc_date") @db.Date
  status          String                @default("DRAFT") @db.VarChar(20)
  notes           String?
  vehicleNumber   String?               @map("vehicle_number") @db.VarChar(50)
  transporterName String?               @map("transporter_name") @db.VarChar(200)
  placeOfSupply   String?               @map("place_of_supply") @db.VarChar(100)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  items           DeliveryChallanItem[]
  customer        Customer?             @relation(fields: [customerId], references: [id])
  quotations      Quotation?            @relation(fields: [quotationId], references: [id])
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  EWayBill        EWayBill?

  @@index([customerId])
  @@index([quotationId])
  @@index([userId])
  @@map("delivery_challans")
}

model Expense {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  expenseName  String   @map("expense_name") @db.VarChar(200)
  amount       Decimal  @db.Decimal(15, 2)
  expenseDate  DateTime @map("expense_date") @db.Date
  category     String   @default("General") @db.VarChar(100)
  deductProfit Boolean  @default(true) @map("deduct_profit")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  status       String   @default("ACTIVE")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expenseDate])
  @@index([userId])
  @@map("expenses")
}

model FinancialYear {
  id                Int                @id @default(autoincrement())
  userId            Int                @map("user_id")
  name              String             @db.VarChar(50)
  startDate         DateTime           @map("start_date") @db.Date
  endDate           DateTime           @map("end_date") @db.Date
  status            PeriodStatus       @default(OPEN)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  accountingPeriods AccountingPeriod[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, startDate, endDate])
  @@map("financial_years")
}

model GstAdjustment {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  sellerName    String   @map("seller_name") @db.VarChar(200)
  sellerGstin   String?  @map("seller_gstin")
  gstBillAmount Decimal  @default(0) @map("gst_bill_amount") @db.Decimal(15, 2)
  pctPaid       Decimal  @default(0) @map("pct_paid") @db.Decimal(6, 2)
  amountPaid    Decimal  @default(0) @map("amount_paid") @db.Decimal(15, 2)
  profitAmount  Decimal  @default(0) @map("profit_amount") @db.Decimal(15, 2)
  txnDate       DateTime @map("txn_date") @db.Date
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gst_adjustments")
}

model GstInputBill {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  billNo      String   @map("bill_no") @db.VarChar(100)
  billDate    DateTime @map("bill_date") @db.Date
  sellerName  String   @map("seller_name") @db.VarChar(200)
  sellerGstin String?  @map("seller_gstin")
  gstAmount   Decimal  @default(0) @map("gst_amount") @db.Decimal(15, 2)
  igstAmount  Decimal  @default(0) @map("igst_amount") @db.Decimal(15, 2)
  cgstAmount  Decimal  @default(0) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount  Decimal  @default(0) @map("sgst_amount") @db.Decimal(15, 2)
  amountPaid  Decimal  @default(0) @map("amount_paid") @db.Decimal(15, 2)
  category    String   @default("General") @db.VarChar(100)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  status      String   @default("ACTIVE")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gst_input_bills")
}

model GstItcLedger {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  ledgerMonth  String   @map("ledger_month") @db.VarChar(7)
  openingIgst  Decimal  @default(0) @map("opening_igst") @db.Decimal(15, 2)
  openingCgst  Decimal  @default(0) @map("opening_cgst") @db.Decimal(15, 2)
  openingSgst  Decimal  @default(0) @map("opening_sgst") @db.Decimal(15, 2)
  utilizedIgst Decimal  @default(0) @map("utilized_igst") @db.Decimal(15, 2)
  utilizedCgst Decimal  @default(0) @map("utilized_cgst") @db.Decimal(15, 2)
  utilizedSgst Decimal  @default(0) @map("utilized_sgst") @db.Decimal(15, 2)
  closingIgst  Decimal  @default(0) @map("closing_igst") @db.Decimal(15, 2)
  closingCgst  Decimal  @default(0) @map("closing_cgst") @db.Decimal(15, 2)
  closingSgst  Decimal  @default(0) @map("closing_sgst") @db.Decimal(15, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ledgerMonth])
  @@index([userId])
  @@map("gst_itc_ledger")
}

model GstPayment {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  paymentMonth String   @map("payment_month") @db.VarChar(7)
  amountPaid   Decimal  @map("amount_paid") @db.Decimal(15, 2)
  paymentDate  DateTime @map("payment_date") @db.Date
  reference    String?  @db.VarChar(100)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gst_payments")
}

model Intermediary {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  sellerCompany String   @map("seller_company") @db.VarChar(200)
  buyerCompany  String   @map("buyer_company") @db.VarChar(200)
  materialName  String?  @map("material_name") @db.VarChar(200)
  quantity      Decimal  @default(0) @db.Decimal(15, 3)
  profitPerUnit Decimal  @default(0) @map("profit_per_unit") @db.Decimal(15, 4)
  totalProfit   Decimal  @default(0) @map("total_profit") @db.Decimal(15, 2)
  dealDate      DateTime @map("deal_date") @db.Date
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("intermediary")
}

model InventoryLayer {
  id                Int                @id @default(autoincrement())
  userId            Int                @map("user_id")
  materialId        Int?               @map("material_id")
  sourceType        String             @db.VarChar(50)
  sourceId          Int?               @map("source_id")
  receivedDate      DateTime           @map("received_date") @db.Date
  originalQty       Decimal            @map("original_qty") @db.Decimal(15, 3)
  remainingQty      Decimal            @map("remaining_qty") @db.Decimal(15, 3)
  unitCostEnc       String             @map("unit_cost_enc")
  material          Material?          @relation(fields: [materialId], references: [id])
  warehouseId       Int?               @map("warehouse_id")
  warehouse         Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  layerConsumptions LayerConsumption[]

  @@index([userId, materialId, remainingQty, receivedDate, id])
  @@map("inventory_layers")
}

model InventoryLedger {
  id            Int        @id @default(autoincrement())
  userId        Int        @map("user_id")
  materialId    Int?       @map("material_id")
  txnDate       DateTime   @map("txn_date") @db.Date
  movementType  String     @db.VarChar(50)
  quantity      Decimal    @db.Decimal(15, 3)
  referenceType String     @db.VarChar(50)
  referenceId   Int?       @map("reference_id")
  notes         String?
  createdAt     DateTime   @default(now()) @map("created_at")
  material      Material?  @relation(fields: [materialId], references: [id])
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  Warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  warehouseId   Int?

  @@index([referenceType, referenceId])
  @@index([userId, materialId, txnDate])
  @@map("inventory_ledger")
}

model Investor {
  id             Int            @id @default(autoincrement())
  userId         Int            @map("user_id")
  investorName   String         @map("investor_name") @db.VarChar(200)
  mobile         String?
  investedAmount Decimal        @default(0) @map("invested_amount") @db.Decimal(15, 2)
  profitPct      Decimal        @default(0) @map("profit_pct") @db.Decimal(6, 2)
  joinedDate     DateTime?      @map("joined_date") @db.Date
  status         InvestorStatus @default(Active)
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("investors")
}

model JournalEntry {
  id                                    Int           @id @default(autoincrement())
  userId                                Int           @map("user_id")
  journalNo                             String?       @map("journal_no") @db.VarChar(100)
  journalDate                           DateTime      @map("journal_date") @db.Date
  description                           String?
  referenceType                         String?       @map("reference_type") @db.VarChar(50)
  referenceId                           Int?          @map("reference_id")
  status                                String        @default("DRAFT")
  totalDebit                            Decimal       @default(0) @map("total_debit") @db.Decimal(18, 2)
  totalCredit                           Decimal       @default(0) @map("total_credit") @db.Decimal(18, 2)
  postedAt                              DateTime?     @map("posted_at")
  postedBy                              Int?          @map("posted_by")
  cancelledAt                           DateTime?     @map("cancelled_at")
  cancelledBy                           Int?          @map("cancelled_by")
  createdAt                             DateTime      @default(now()) @map("created_at")
  updatedAt                             DateTime      @updatedAt @map("updated_at")
  usersJournalEntriesCancelledByTousers User?         @relation("journal_entries_cancelled_byTousers", fields: [cancelledBy], references: [id])
  usersJournalEntriesPostedByTousers    User?         @relation("journal_entries_posted_byTousers", fields: [postedBy], references: [id])
  usersJournalEntriesUserIdTouser       User          @relation("journal_entries_user_idTousers", fields: [userId], references: [id], onDelete: Cascade)
  lines                                 JournalLine[]

  @@unique([userId, journalNo])
  @@index([journalDate])
  @@index([referenceType, referenceId])
  @@index([status])
  @@index([userId])
  @@map("journal_entries")
}

model JournalLine {
  id             Int            @id @default(autoincrement())
  userId         Int            @map("user_id")
  journalEntryId Int            @map("journal_entry_id")
  accountId      Int            @map("account_id")
  description    String?
  debit          Decimal        @default(0) @db.Decimal(18, 2)
  credit         Decimal        @default(0) @db.Decimal(18, 2)
  lineOrder      Int            @default(0) @map("line_order")
  createdAt      DateTime       @default(now()) @map("created_at")
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id])
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([journalEntryId])
  @@index([userId])
  @@map("journal_lines")
}

model LayerConsumption {
  id               Int            @id @default(autoincrement())
  userId           Int            @map("user_id")
  layerId          Int            @map("layer_id")
  saleItemId       Int            @map("sale_item_id")
  quantityConsumed Decimal        @map("quantity_consumed") @db.Decimal(15, 3)
  unitCostEnc      String         @map("unit_cost_enc")
  inventoryLayers  InventoryLayer @relation(fields: [layerId], references: [id])
  saleItem         SaleItem       @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, layerId])
  @@index([userId, saleItemId])
  @@map("layer_consumptions")
}

model Material {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  materialName String   @map("material_name") @db.VarChar(200)
  hsnCode      String?  @map("hsn_code") @db.VarChar(20)
  unit         String   @default("Nos") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  currentStock Decimal  @default(0) @map("current_stock") @db.Decimal(15, 3)
  isActive     Boolean  @default(true) @map("is_active")

  itemCode         String?       @map("item_code") @db.VarChar(50)
  itemType         ItemType      @default(TRADING_GOOD) @map("item_type")
  categoryId       Int?          @map("category_id")
  description      String?       @db.Text
  inventoryTracked Boolean       @default(true) @map("inventory_tracked")
  purchaseEnabled  Boolean       @default(true) @map("purchase_enabled")
  salesEnabled     Boolean       @default(true) @map("sales_enabled")
  standardPrice    Decimal?      @map("standard_price") @db.Decimal(15, 2)
  standardCost     Decimal?      @map("standard_cost") @db.Decimal(15, 2)
  gstRate          Decimal?      @map("gst_rate") @db.Decimal(5, 2)
  taxability       String        @default("TAXABLE") @db.VarChar(30)
  batchReady       Boolean       @default(false) @map("batch_ready")
  expiryReady      Boolean       @default(false) @map("expiry_ready")
  category         ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  deliveryChallanItems DeliveryChallanItem[]
  inventoryLayers      InventoryLayer[]
  inventoryLedger      InventoryLedger[]
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseItems        PurchaseItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  quotationItems       QuotationItem[]
  saleItems            SaleItem[]
  items                SalesReturnItem[]

  @@unique([userId, itemCode])
  @@index([userId])
  @@map("materials")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
