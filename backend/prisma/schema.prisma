// Phase 6.10H Part 2 — multi-user seats. A TenantUser is a SEPARATE login
// (its own username/password) for staff working under one tenant account.
// Deliberately NOT how the rest of the app scopes tenant data: every business
// table still scopes by `userId` = the tenant's own User.id (see the 24+
// controllers that do `where: { userId: req.user.userId }`). A staff login's
// JWT carries `userId` = the TENANT's id (so all existing business-data
// queries keep working unmodified) plus `staffId`/`staffName` for identifying
// who is actually acting, for audit logging and permission checks
// (role is set to 'staff' in the JWT for a TenantUser session - see
// authController.login/refreshToken and middlewares/auth.ts).
model TenantUser {
  id                  Int      @id @default(autoincrement())
  tenantId            Int      @map("tenant_id")
  fullName            String   @map("full_name") @db.VarChar(150)
  username            String   @unique @db.VarChar(100)
  email               String   @db.VarChar(150)
  password            String   @db.VarChar(255)
  status              String   @default("active") @db.VarChar(20) // active | disabled
  forcePasswordChange Boolean  @default(true) @map("force_password_change")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant User @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_users")
}

