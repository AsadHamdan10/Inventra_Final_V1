// ==========================================
// SAAS PLATFORM BILLING (PHASE 6.9)
// ==========================================

// Phase 6.10H: platformAccess values are "MOBILE" | "DESKTOP" | "DESKTOP_MOBILE".
// status values are "ACTIVE" | "INACTIVE" | "ARCHIVED" - ARCHIVED plans are never
// deleted (historical subscriptions reference them) but can never be selected for
// a new registration/subscription. isActive is kept in sync with status === 'ACTIVE'
// for backward compatibility with existing code that filters on it directly.
model SaaSPlan {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(50)
  name            String    @db.VarChar(100)
  displayName     String?   @map("display_name") @db.VarChar(150) // public/marketing name; falls back to `name`
  description     String?   @db.Text
  annualPrice     Decimal   @map("annual_price") @db.Decimal(15, 2) // legacy: kept in sync with finalPrice for old call sites
  listPrice       Decimal   @default(0) @map("list_price") @db.Decimal(15, 2)
  discountAmount  Decimal   @default(0) @map("discount_amount") @db.Decimal(15, 2)
  finalPrice      Decimal   @default(0) @map("final_price") @db.Decimal(15, 2) // authoritative payable amount
  currency        String    @default("INR") @db.VarChar(10)
  businessType    String    @map("business_type") @db.VarChar(50) // e.g., TRADING, TRADING_MANUFACTURING
  platformAccess  String    @default("DESKTOP") @map("platform_access") @db.VarChar(20)
  durationMonths  Int       @default(12) @map("duration_months")
  includedUsers   Int       @default(5) @map("included_users")
  isActive        Boolean   @default(true) @map("is_active")
  status          String    @default("ACTIVE") @map("status") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  subscriptions   SaaSSubscription[]

  @@map("saas_plans")
}

model SaaSSubscription {
  id                        Int       @id @default(autoincrement())
  userId                    Int       @map("user_id")
  planId                    Int       @map("plan_id")
  status                    String    @default("PENDING") @db.VarChar(30) // PENDING, ACTIVE, EXPIRED, CANCELLED
  startDate                 DateTime  @map("start_date") @db.Date
  endDate                   DateTime  @map("end_date") @db.Date
  listPrice                 Decimal   @map("list_price") @db.Decimal(15, 2) // Snapshotted list price
  discountAmount            Decimal   @default(0) @map("discount_amount") @db.Decimal(15, 2)
  finalAmount               Decimal   @map("final_amount") @db.Decimal(15, 2)
  // Phase 6.10H: commercial entitlement snapshot at the moment this subscription
  // was created/renewed - never re-read from the live plan afterward, so a later
  // edit to the master plan can never retroactively change what this company bought.
  platformAccess            String    @default("DESKTOP") @map("platform_access") @db.VarChar(20)
  durationMonths            Int       @default(12) @map("duration_months")
  includedUsers             Int       @default(5) @map("included_users")
  renewedFromSubscriptionId Int?      @map("renewed_from_subscription_id")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user            User      @relation(fields: [userId], references: [id])
  plan            SaaSPlan  @relation(fields: [planId], references: [id])
  payments        SaaSPayment[]
  renewedFrom     SaaSSubscription?  @relation("SubscriptionRenewal", fields: [renewedFromSubscriptionId], references: [id])
  renewals        SaaSSubscription[] @relation("SubscriptionRenewal")

  @@map("saas_subscriptions")
}

model SaaSPayment {
  id                    Int       @id @default(autoincrement())
  subscriptionId        Int       @map("subscription_id")
  userId                Int       @map("user_id")
  amountReceived        Decimal   @map("amount_received") @db.Decimal(15, 2)
  paymentDate           DateTime  @map("payment_date") @db.Date
  paymentMethod         String    @db.VarChar(50) // CASH, BANK_TRANSFER, UPI, CHEQUE, OTHER
  transactionReference  String?   @map("transaction_reference") @db.VarChar(100)
  receiptNumber         String?   @map("receipt_number") @db.VarChar(100)
  notes                 String?   @db.Text
  recordedBy            Int       @map("recorded_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  subscription          SaaSSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user                  User              @relation("SaaSPayments", fields: [userId], references: [id])
  recordedByUser        User              @relation("RecordedPayments", fields: [recordedBy], references: [id])
  commissions           SaaSCommission[]

  @@map("saas_payments")
}

model SaaSCommission {
  id                  Int       @id @default(autoincrement())
  paymentId           Int       @map("payment_id")
  marketerName        String    @map("marketer_name") @db.VarChar(150)
  commissionAmount    Decimal   @map("commission_amount") @db.Decimal(15, 2)
  notes               String?   @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")

  payment             SaaSPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("saas_commissions")
}

model SaaSExpense {
  id              Int       @id @default(autoincrement())
  expenseDate     DateTime  @map("expense_date") @db.Date
  category        String    @db.VarChar(100)
  amount          Decimal   @db.Decimal(15, 2)
  description     String?   @db.VarChar(255)
  reference       String?   @db.VarChar(100)
  notes           String?   @db.Text
  recordedBy      Int       @map("recorded_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("saas_expenses")
}
